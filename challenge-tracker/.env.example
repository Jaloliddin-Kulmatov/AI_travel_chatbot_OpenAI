# --- Database (PostgreSQL 14+; Supabase connection string works too) ---
DATABASE_URL=postgres://app:app@127.0.0.1:5432/challenges
# Used only by `npm run test:integration` (a separate, disposable database!)
TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5432/challenges_test

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# --- Optional ---
# Set to "true" to allow `npm run db:seed` to create the labelled demo account
ENABLE_DEMO_SEED=false
